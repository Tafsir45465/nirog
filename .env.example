FLASK_ENV=development
SECRET_KEY=change-this-secret
JWT_SECRET_KEY=change-this-jwt-secret
DATABASE_URL=sqlite:///nirog.db
BUSINESS_TIMEZONE=Asia/Dhaka
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
MAX_UPLOAD_MB=10
RATELIMIT_STORAGE_URI=memory://

# Video Consultation (jitsi, zoom, google_meet)
VIDEO_PROVIDER=jitsi
JITSI_BASE_URL=https://meet.jit.si
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
GOOGLE_MEET_CREDENTIALS_FILE=

# Notifications
NOTIFICATION_CHANNELS=in_app,email,sms
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMS_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Push Notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@nirog.local

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_TYPE=local  # local, s3, gcs
BACKUP_LOCAL_PATH=./backups
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_GCS_BUCKET=
BACKUP_GCS_PROJECT_ID=
BACKUP_GCS_KEY_FILE=

# QR Code Settings
QR_CODE_SIZE=10
QR_CODE_BORDER=4
QR_CODE_ERROR_CORRECTION=L
QR_CODE_CLEANUP_DAYS=365

# File Upload Settings
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg
UPLOAD_FOLDER=./uploads

# Rate Limiting
RATELIMIT_ENABLED=true
RATELIMIT_DEFAULT=100 per hour
RATELIMIT_STORAGE_URI=memory://

# Advanced Features
ENABLE_ANALYTICS=true
ENABLE_BILLING_DASHBOARD=true
ENABLE_ADVANCED_REPORTS=true

